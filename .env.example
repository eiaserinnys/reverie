# Reverie Configuration
# Copy to .env and fill in actual values

# Database (PostgreSQL + pgvector) - required
REVERIE_DB_HOST=localhost
REVERIE_DB_PORT=5432
REVERIE_DB_USER=your-db-user
REVERIE_DB_PASSWORD=your-db-password
REVERIE_DB_NAME=reverie

# OpenAI API - required for embeddings
REVERIE_OPENAI_API_KEY=sk-...

# LLM Models - required
REVERIE_OPENIE_MODEL=gpt-5-mini
REVERIE_RECOGNITION_MODEL=gpt-5-mini
REVERIE_PREPROCESSOR_MODEL=gpt-5-mini

# Session JSONL directory - required
# Path to Claude Code session files
REVERIE_SESSION_DIR=/path/to/.claude/projects

# API Cache directory (optional)
# REVERIE_CACHE_DIR=/path/to/cache

# Profile name (optional, default: "default")
# REVERIE_PROFILE=default

# Embedding settings (optional)
# REVERIE_EMBEDDING_MODEL=text-embedding-3-small
# REVERIE_EMBEDDING_DIMENSIONS=1536

# Chunking settings (optional)
# REVERIE_CHUNK_TOKEN_LIMIT=2000
# REVERIE_TOOL_RESULT_MAX_LINES=20

# Graph settings (optional)
# REVERIE_SYNONYM_THRESHOLD=0.8
# REVERIE_PPR_DAMPING=0.85
# REVERIE_PPR_TOP_K=10

# Retrieval settings (optional)
# REVERIE_KNN_TOP_K=50
# REVERIE_RECALL_MAX_PASSAGES=5
# REVERIE_RECALL_MAX_TOKENS=4000

# API settings - required
# CORS origin - use "*" for development, specific origin for production
REVERIE_CORS_ORIGIN=*
